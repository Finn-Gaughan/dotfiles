// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{


  "terminal": {
    "shell": {
      "program": "/bin/zsh"
    }
  },
  "agent": {
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.4",
      "enable_thinking": true,
      "effort": "high"
    },
    "favorite_models": [],
    "default_profile": "write",
    "model_parameters": []
  },
  "edit_predictions": {
    "mode": "eager"
  },
  "disable_ai": false,
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark Hard",
  },
  // show line number thing
  "show_wrap_guides": true,
    "wrap_guides": [80],
    "preferred_line_length": 80,
    // remove nerd font -> and !=
    "buffer_font_features": {
        "calt": false
      },
  // junk added by ai to make it so typst works with a preview that updates when i save
    "lsp": {
      "tinymist": {
        "initialization_options": {
          "exportPdf": "onSave"
        }
      }
    }
}
